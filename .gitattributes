# I file di testo restano LF anche al checkout su Windows.
* text=auto eol=lf
# I reperti WKB sono byte, non testo: nessuna conversione di fine riga.
*.wkb binary
# Il catalogo delle misure e' la fonte del modello di costo: i byte restano
# quelli della campagna, cosi' lo SHA-256 registrato nel modello resta vero.
data/misure/*.json -text
# File di dati binari delle fixture di plenora-io.
*.parquet binary
*.arrow binary
# Griglie NTv2 (fixture della riproiezione): byte, non testo.
*.gsb binary
# Schemi copiati da plenora-contracts: i byte restano quelli del contratto,
# cosi' lo SHA-256 verificato dal test resta vero.
crates/plenora-core/tests/fixtures/contratti/*.json -text
