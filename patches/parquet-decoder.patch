+    let prefix_length = usize::try_from(prefix_length)
+        .ok()
+        .filter(|prefix| *prefix <= previous_length)
+        .ok_or_else(|| {
+            general_err!("invalid DELTA_BYTE_ARRAY prefix length: beyond the previous value")
