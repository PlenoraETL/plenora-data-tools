+        impl<T> crate::RTreeObject for MultiPolygon<T>
+        where
+            T: ::num_traits::Float + crate::RTreeNum,
+        {
+            type Envelope = crate::AABB<Point<T>>;
+            fn envelope(&self) -> Self::Envelope {
+                use crate::Envelope;
+                self.iter()
+                    .map(|p| p.envelope())
+                    .fold(crate::AABB::new_empty(), |a, b| a.merged(&b))
