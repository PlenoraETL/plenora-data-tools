+//! SONDE TEMPORANEE DI MISURA — **NON DEVE ENTRARE IN UN COMMIT PRODUTTIVO**.
+//!
+//! Accumulatori per sottofase del percorso di esecuzione, usati una sola
+//! volta per attribuire il residuo di `table.formula` (vedi
+//! `docs/decomposizione-wall-2026-08-20.md`). Non toccano alcuna API
+//! pubblica gia' esistente ne' la semantica delle metriche: sono un canale
+//! separato, thread-locale, che l'engine alimenta e l'harness legge.
+//!
+//! Il costo delle sonde stesse e' misurabile con [`calibra`] e va sottratto
+//! — o almeno dichiarato — prima di leggere i numeri.
+
+#![allow(clippy::cast_precision_loss)] // solo diagnostica di calibrazione
+
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::time::{Duration, Instant};
+
+thread_local! {
+    /// Per nome di sottofase: numero di campioni e nanosecondi cumulati.
+    static ACCUMULO: RefCell<BTreeMap<&'static str, (u64, u128)>> =
+        const { RefCell::new(BTreeMap::new()) };
+}
+
+/// Aggiunge un campione a una sottofase.
+pub fn aggiungi(fase: &'static str, durata: Duration) {
+    ACCUMULO.with(|a| {
+        let mut mappa = a.borrow_mut();
+        let voce = mappa.entry(fase).or_insert((0, 0));
+        voce.0 += 1;
+        voce.1 += durata.as_nanos();
+    });
+}
+
+/// Cronometra `corpo` attribuendolo a `fase`.
+pub fn misura<T>(fase: &'static str, corpo: impl FnOnce() -> T) -> T {
+    let inizio = Instant::now();
+    let esito = corpo();
+    aggiungi(fase, inizio.elapsed());
+    esito
+}
+
+/// Azzera tutti gli accumulatori.
+pub fn azzera() {
+    ACCUMULO.with(|a| a.borrow_mut().clear());
+}
+
+/// Sottofasi accumulate: `(nome, campioni, nanosecondi)`.
+#[must_use]
+pub fn leggi() -> Vec<(String, u64, u128)> {
+    ACCUMULO.with(|a| {
+        a.borrow()
+            .iter()
+            .map(|(nome, (n, ns))| ((*nome).to_owned(), *n, *ns))
+            .collect()
+    })
+}
+
+/// Costo di UNA sonda (coppia `Instant::now()` + accumulo), in nanosecondi.
+///
+/// Si misura con lo stesso meccanismo che si vuole calibrare, su un corpo
+/// vuoto: la differenza fra il tempo totale e zero e' interamente sonda.
+/// Serve a dire quanta parte dei numeri riportati e' la misura stessa.
+#[must_use]
+pub fn calibra(giri: u32) -> f64 {
+    azzera();
+    let inizio = Instant::now();
+    for _ in 0..giri {
+        misura("calibrazione", || {});
+    }
+    let totale = inizio.elapsed().as_nanos() as f64;
+    azzera();
+    totale / f64::from(giri)
+}
