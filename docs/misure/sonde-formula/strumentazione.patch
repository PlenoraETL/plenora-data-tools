+/// Fase SONDE — **temporanea**, dipende dalle sonde in `plenora_engine::sonde`
+/// che non devono entrare in un commit produttivo.
+///
+/// Attribuisce il residuo di `table.formula` alle sottofasi del percorso di
+/// esecuzione, confrontando sullo STESSO percorso tre piani a nodo singolo:
+/// `formula`, `formula` costante e `string_pad`.
+/// Sottofasi che stanno DENTRO `catena_streaming`: sommarle insieme a lei
+/// conterebbe due volte. Sono foglie solo quando la catena non e' strumentata
+/// come contenitore, cioe' sui piani che non passano dal percorso
+/// row-diagnostics.
+const DENTRO_LA_CATENA: [&str; 6] = [
+    "run_kernel",
+    "pre_kernel",
+    "dimensione_output",
+    "controlli_edge",
+    "metriche",
+    "governor",
+];
+const CONTENITORE: &str = "catena_streaming";
+/// La scansione row-diagnostics contiene staging, catena e chiusura.
+const CONTENITORE_SCANSIONE: &str = "scansione_row_diagnostics";
+/// `replay_batch` contiene decodifica, compattazione e reservation.
+const CONTENITORE_REPLAY: &str = "replay_batch";
+const DENTRO_IL_REPLAY: [&str; 3] = [
+    "replay_decodifica_ipc",
+    "replay_compattazione",
+    "replay_governor",
+];
+const DENTRO_LA_SCANSIONE: [&str; 4] = [
+    "lettura_routing",
+    "catena_streaming",
+    "staging_ipc",
+    "staging_chiusura",
+];
+
+fn fase_sonde() -> Value {
+    // Costo di una sonda, misurato con lo stesso meccanismo su corpo vuoto:
+    // serve a dire quanta parte dei numeri sotto e' la misura stessa.
+    let costo_sonda_ns = plenora_engine::sonde::calibra(200_000);
+
+    let mut misure = Vec::new();
+    for (nome, carico) in carichi_per_operazione() {
+        let banco = Banco::nuovo_con(&carico, BATCH, RIGHE_PER_BATCH, true);
+        // Warm-up fuori misura: il primo giro paga temp dir e pool.
+        for _ in 0..WARMUP {
+            drop(banco.esegui());
+        }
+
+        // Un campione per ripetizione, non un cumulato: cosi' si riporta la
+        // MEDIANA di ogni sottofase, come nel resto dell'harness. Una media
+        // su cumulati e' dominata dalla ripetizione peggiore, e su questo
+        // host la ripetizione peggiore e' contesa, non misura.
+        let mut serie: BTreeMap<String, Vec<u64>> = BTreeMap::new();
+        let mut campioni: BTreeMap<String, u64> = BTreeMap::new();
+        let mut walls = Vec::new();
+        let mut kernel = Vec::new();
+        let mut costruzioni = Vec::new();
+        for _ in 0..RIPETIZIONI_SONDE {
+            let inputs = banco.inputs();
+            plenora_engine::sonde::azzera();
+            let spesa = banco.esegui_diviso(inputs);
+            // Wall e sonde vengono dalla STESSA esecuzione: misurarli in
+            // cicli separati li espone a due stati diversi dell'host e la
+            // somma non chiude per ragioni che non riguardano
+            // l'attribuzione (visto: 116% e 84% sullo stesso codice).
+            for (fase, quanti, nanosecondi) in plenora_engine::sonde::leggi() {
+                serie
+                    .entry(fase.clone())
+                    .or_default()
+                    .push(u64::try_from(nanosecondi).unwrap_or(u64::MAX));
+                campioni.insert(fase, quanti);
+            }
+            walls.push(ns(spesa.wall()));
+            kernel.push(ns(spesa.kernel));
+            costruzioni.push(ns(spesa.costruzione));
+        }
+        plenora_engine::sonde::azzera();
+
+        let wall = statistica(&walls).0;
+        let costruzione = statistica(&costruzioni).0;
+        let mediana_fase = |fase: &str| -> u64 { serie.get(fase).map_or(0, |v| statistica(v).0) };
+
+        // La catena e' un contenitore solo se e' stata effettivamente
+        // attraversata: sui piani senza row-diagnostics non esiste, e allora
+        // le sue sottofasi sono le foglie.
+        let catena_presente = serie.contains_key(CONTENITORE);
+        let scansione_presente = serie.contains_key(CONTENITORE_SCANSIONE);
+        // Gerarchia dei contenitori: la scansione row-diagnostics contiene
+        // lettura, catena, staging e chiusura; la catena contiene kernel e
+        // controlli di confine. Si sommano SOLO i contenitori piu' esterni e
+        // le sottofasi che non stanno dentro nessuno.
+        let replay_presente = serie.contains_key(CONTENITORE_REPLAY);
+        let dentro = |fase: &str| -> bool {
+            (scansione_presente && DENTRO_LA_SCANSIONE.contains(&fase))
+                || (catena_presente && DENTRO_LA_CATENA.contains(&fase))
+                || (replay_presente && DENTRO_IL_REPLAY.contains(&fase))
+        };
+        let foglie: u64 = serie
+            .keys()
+            .filter(|fase| !dentro(fase.as_str()))
+            .map(|fase| mediana_fase(fase))
+            .sum::<u64>()
+            + costruzione;
+
+        let sottofasi: Vec<Value> = serie
+            .keys()
+            .map(|fase| {
+                let mediana = mediana_fase(fase);
+                let quanti = campioni.get(fase).copied().unwrap_or(0);
+                json!({
+                    "fase": fase,
+                    "contenitore": (catena_presente && fase == CONTENITORE)
+                        || (scansione_presente && fase == CONTENITORE_SCANSIONE)
+                        || (replay_presente && fase == CONTENITORE_REPLAY),
+                    "dentro_un_contenitore": dentro(fase.as_str()),
+                    "campioni_per_esecuzione": quanti,
+                    "ns_per_esecuzione": mediana,
+                    "quota_wall_pct": quota(
+                        Duration::from_nanos(mediana),
+                        Duration::from_nanos(wall),
+                    ),
+                    // Quanto di questa voce e' costo della sonda stessa.
+                    "sonda_ns": costo_sonda_ns * quanti as f64,
+                })
+            })
+            .collect();
+
+        let kernel = statistica(&kernel).0;
+        misure.push(json!({
+            "operazione": nome,
+            "wall_ns": wall,
+            "kernel_ns": kernel,
+            "costruzione_ns": costruzione,
+            "residuo_ns": wall.saturating_sub(kernel),
+            "ripetizioni": RIPETIZIONI_SONDE,
+            "somma_foglie_ns": foglie,
+            "copertura_wall_pct": quota(
+                Duration::from_nanos(foglie),
+                Duration::from_nanos(wall),
+            ),
+            // La domanda vera: quanto del RESIDUO — cioe' del wall che i
+            // tempi per nodo non coprono — e' attribuito a una sottofase
+            // nominata. Si toglie il kernel da entrambi i lati.
+            "residuo_spiegato_ns": foglie.saturating_sub(kernel),
+            "copertura_residuo_pct": quota(
+                Duration::from_nanos(foglie.saturating_sub(kernel)),
+                Duration::from_nanos(wall.saturating_sub(kernel)),
+            ),
+            "sottofasi": sottofasi,
+        }));
+    }
+
+    json!({
+        "carico": "sonde",
+        "descrizione": "attribuzione del residuo alle sottofasi, 24 x 8192",
+        "costo_sonda_ns": costo_sonda_ns,
+        "misure": misure,
+    })
+}
