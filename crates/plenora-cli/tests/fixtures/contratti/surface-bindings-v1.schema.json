{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/surface-bindings-v1.schema.json",
  "title": "Plenora normative surface bindings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "surface", "components"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "contract": {"const": "plenora-surface-bindings-v1"},
    "surface": {"enum": ["cli", "python_sdk", "runtime"]},
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "artifact", "discovery", "bindings"],
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^plenora-[a-z][a-z0-9-]+-tools$"
          },
          "artifact": {"type": ["string", "null"], "maxLength": 128},
          "discovery": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          "bindings": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "version", "requirement", "entrypoints"],
              "properties": {
                "operation": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
                },
                "version": {"type": "integer", "minimum": 1},
                "requirement": {"enum": ["required", "conditional", "extension"]},
                "entrypoints": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "maxLength": 256}
                },
                "deprecated_aliases": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "maxLength": 256}
                }
              }
            }
          }
        }
      }
    }
  }
}
