{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/data-plan-v1.schema.json",
  "title": "Plenora data plan v1",
  "description": "Closed plan document accepted by data.validate and data.run version 2 (specs/data/DATA-PLAN-1.0.md). Name relations and kernel identity are checked semantically.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "inputs", "steps", "outputs"],
  "properties": {
    "version": {"const": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "crs": {"type": "string", "minLength": 1},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_rows": {"$ref": "#/$defs/positive_integer"},
        "max_output_rows": {"$ref": "#/$defs/positive_integer"},
        "max_rows_per_edge": {"$ref": "#/$defs/positive_integer"},
        "max_expansion_factor": {"type": "number", "exclusiveMinimum": 0},
        "max_governed_memory_bytes": {"$ref": "#/$defs/positive_integer"},
        "max_string_bytes": {"$ref": "#/$defs/positive_integer"},
        "max_regex_bytes": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["out", "op", "in"],
        "properties": {
          "out": {"$ref": "#/$defs/name"},
          "op": {"type": "string", "pattern": "^(table|geo)\\.[a-z][a-z0-9_]*$"},
          "in": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/name"}
          },
          "config": {"type": "object"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    }
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
  }
}
